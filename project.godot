; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ascendence"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.5")

[autoload]

GameEvents="*res://scripts/systems/game_events.gd"
RunConfig="*res://scripts/systems/run_config.gd"
GameSettings="*res://scripts/systems/game_settings.gd"
MetaProgression="*res://scripts/systems/meta_progression.gd"
TownState="*res://scripts/systems/town_state.gd"
AudioDirector="*res://scripts/systems/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

